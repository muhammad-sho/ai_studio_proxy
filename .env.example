# Copy to .env before deploying with Docker Compose.
# Every setting is optional: the defaults below match docker-compose.yml.

# Image and persistent host directory
# AI_STUDIO_PROXY_IMAGE=ghcr.io/muhammad-sho/ai-studio-proxy:latest
# DATA_DIR=./data

# Exposed container ports
# ADMIN_PORT=9009
# API_PORT=9008

# SQLite path inside the container. Keep it inside the mounted /data directory.
# DB_PATH=/data/ai-studio-proxy.db

# Extra debug logging (for troubleshooting)
# DEBUG=1

# Set to 1 only behind a trusted reverse proxy that controls X-Forwarded-For.
# TRUST_PROXY=1

# Upstream request timeout in milliseconds
# REQUEST_TIMEOUT_MS=120000

# Max request body size in bytes (default: 50MB)
# MAX_BODY_BYTES=52428800

# Max forwarded response size in bytes (default: 50MB)
# MAX_RESPONSE_BYTES=52428800

# Max payload stored per log entry in bytes
# LOG_BODY_MAX_BYTES=65536

# Max request-log entries kept (older pruned hourly)
# MAX_LOG_ENTRIES=1000

# Hours before the cached model list refreshes
# MODELS_CACHE_TTL_HOURS=24

# CORS origin header for browser-based clients. Restrict this in production.
# CORS_ORIGIN=*
