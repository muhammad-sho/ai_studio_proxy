# All settings below are optional and commented out.
# PORT and DB_PATH are already set in docker-compose.yml.

# Run the admin dashboard and the API on separate ports.
# Set both to different values to split them (recommended for internet exposure).
# When unset (or equal), everything runs on PORT together.
# ADMIN_PORT=9009
# API_PORT=9008

# Extra debug logging (for troubleshooting)
# DEBUG=1

# Set to 1 if behind a reverse proxy (honors X-Forwarded-For)
# TRUST_PROXY=1

# Upstream request timeout in milliseconds
# REQUEST_TIMEOUT_MS=120000

# Max request body size in bytes (default: 50MB)
# MAX_BODY_BYTES=52428800

# Max forwarded response size in bytes (default: 50MB)
# MAX_RESPONSE_BYTES=52428800

# Max payload stored per log entry in bytes
# LOG_BODY_MAX_BYTES=65536

# Max request-log entries kept (older pruned hourly)
# MAX_LOG_ENTRIES=1000

# Hours before the cached model list refreshes
# MODELS_CACHE_TTL_HOURS=24

# CORS origin header for browser-based clients
# CORS_ORIGIN=*
