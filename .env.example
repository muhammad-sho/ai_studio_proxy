# Optional non-secret runtime settings. Normal setup is done in the dashboard.
PORT=9009
DB_PATH=./ai-studio-proxy.db

# Logging: every request, upstream call, key rotation decision, auth event
# and admin action is logged with a timestamp. Secrets are always masked.
# Optional: extra per-attempt trace logging
# DEBUG=1

# Optional tuning:
# REQUEST_TIMEOUT_MS=120000
# MAX_BODY_BYTES=10485760
# Hours before the cached model list is considered stale and refreshed
# in the background on next access (default 24)
# MODELS_CACHE_TTL_HOURS=24
# Max bytes per request/response body stored in request logs (default 65536)
# LOG_BODY_MAX_BYTES=65536
# Maximum request-log entries retained in the database; entries older than
# 7 days are removed regardless of count. Pruning runs hourly. (default 1000)
# MAX_LOG_ENTRIES=1000
