# Optional Docker settings.
# Copy this file to ./volumes/.env only when you need to change a default.
# Uncomment only the settings you need, then restart the container.
# Invalid values safely fall back to their built-in defaults.

# SQLite path inside the container. Keep it inside /data.
# DB_PATH=/data/ai-studio-proxy.db

# Extra debug logging
# DEBUG=1

# Set only behind a trusted reverse proxy.
# TRUST_PROXY=1

# Upstream request timeout in milliseconds
# REQUEST_TIMEOUT_MS=120000

# Request/response limits in bytes (defaults: 50MB)
# MAX_BODY_BYTES=52428800
# MAX_RESPONSE_BYTES=52428800

# Request-log retention
# LOG_BODY_MAX_BYTES=65536
# MAX_LOG_ENTRIES=1000

# Optional usage retention in days (0 keeps usage history forever)
# USAGE_RETENTION_DAYS=0

# Restrict browser clients in production.
# CORS_ORIGIN=*
